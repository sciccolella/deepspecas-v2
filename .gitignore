__pycache__
.vscode
.snakemake

# Transformer fold checkpoints: 27MB per run, reproducible in ~7 min from
# the committed JSON/log (dsignal/train.py, seed 0). Metrics are committed.
runs/*/
# ...except the committed ensemble specs (small JSON, no checkpoints) --
# every reported ensemble must be reproducible from a file, not a shell glob.
!runs/ensembles/
!runs/ensembles/*.json

# SUPPA event catalogue: 40MB of .ioe, regenerated on pasteur from the GTF
# (SUPPA2 generateEvents). sim/catalogue.py reads it; nothing needs it in git.
sim/events/

# Track B arena BAMs (Stage 12). ~500MB of region subsets -- an order of
# magnitude larger than benchmark/ (18MB) and benchmark_new/ (71MB), which are
# committed. Rebuild with benchmark_build/run_arena.sh + samtools view -L, or
# re-copy from pasteur; the candidate CSVs, consensus.tsv and events.bed that
# define the arena *are* committed.
ptbp1_arena/*.bam
ptbp1_arena/*.bam.bai
# arena build intermediates (31MB: rMATS tables, .dpsi, TPM matrices) -- the
# arena is *defined* by consensus.tsv + candidates/, which are committed; these
# are reproducible with benchmark_build/run_arena.sh or re-copyable from pasteur
ptbp1_arena/build/

# Stage 18 domain probe: the logs/TSVs/JSON summaries are the result and are
# small; the cached feature tables (*.npz, ~10MB each) rebuild in a minute
# from committed npz + labels with `dsignal.domain_probe build`.
!runs/domain_probe/
runs/domain_probe/*.npz

# Stage 20.1 arena build / extraction logs for pairs 3 and 4 (small)
!runs/stage20/

# Stage 19 junction tail: logs/TSV/JSON are the result and are committed; the
# overlay npz and domain-probe tables rebuild in about a minute from committed
# npz with sim.tail_overlay / dsignal.domain_probe build.
!runs/stage19/
runs/stage19/**/*.npz

# Stage 22b union pool: filtered out of the v2 repo history; rebuildable/fetched
sim/experiment/npz_union/

# Binary/large data is never committed here (see DATA.md)
*.bam
*.bai
*.npz
*.pth
